generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  GRAPHIC_TEAM_LEADER
  MAPPING_INSPECTOR
  GRAPHIC_QA
  SUPERVISOR
  SUPERVISOR_SHIFT_LEADER
  OPS_ADMIN
  OPS_MANAGER_2
}

enum MapPhase {
  INTAKE
  PREP
  UPLOAD_REVIEW
  FIELD
  POLISH
  QA_REVIEW
  APPROVED
  CANCELLED
}

enum InspectorStatus {
  ACCEPTED
  PROCESSING
  DONE
}

enum SupervisorStatus {
  ACCEPTED
  PROCESSING
  DONE
}

enum FieldWorkStatus {
  UNCOMPLETED
  COMPLETED
  CANCELLED
}

enum QaStatus {
  FIX
  FIX_DONE
  APPROVED
}

enum TaskStatus {
  PENDING
  ACCEPTED
  PROCESSING
  DONE
  FIX
  FIX_DONE
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  avatarUrl String?
  googleId  String?    @unique
  shiftStartedAt DateTime?
  fridayContract   Boolean  @default(false)
  hagimOk          Boolean  @default(false)
  roles     UserRole[]
  assignedMapsAsInspector Map[]  @relation("InspectorMaps")
  assignedMapsAsQa      Map[]  @relation("QaMaps")
  assignedMapsAsSupervisor Map[] @relation("SupervisorMaps")
  assignedTasks           Task[]
  createdTasks            Task[] @relation("TaskCreator")
  events                  MapEvent[]
  phaseHistory            MapPhaseHistory[]
  attachments             MapAttachment[]
  notes                   MapNote[]
  availabilitySubmissions AvailabilitySubmission[]
  shiftPlansCreated       ShiftPlan[]           @relation("ShiftPlansCreated")
  shiftPlanAssignments    ShiftPlanAssignment[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model UserRole {
  id     String   @id @default(cuid())
  userId String
  role   RoleName
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Map {
  id              String           @id @default(cuid())
  mapNumber       String           @unique
  jiraTicketId    String?
  client          String
  area            String?
  description     String?
  dueDate         DateTime?
  fieldDate       DateTime?
  loomDone        Boolean          @default(false)
  positioning     Boolean          @default(false)
  mapperName      String?
  opsManagerComment String?
  fieldWorkStatus FieldWorkStatus  @default(UNCOMPLETED)
  fieldProgressPercent Int          @default(0)
  onHubStatusBoard  Boolean          @default(false)
  /** null = N/A; true = SL approved complete; false = completed without SL approval */
  shiftLeaderApproved Boolean?
  /** Scheduled return when incomplete/cancelled and mapper will continue later */
  returnVisitAt   DateTime?
  phase           MapPhase         @default(INTAKE)
  inspectorStatus InspectorStatus?
  supervisorStatus SupervisorStatus?
  qaStatus        QaStatus?
  uploadApproved  Boolean          @default(false)
  uploadCompletedAt DateTime?
  releasedToGraphics Boolean       @default(false)
  assignedInspectorId String?
  assignedInspector   User?        @relation("InspectorMaps", fields: [assignedInspectorId], references: [id])
  assignedQaId        String?
  assignedQa          User?        @relation("QaMaps", fields: [assignedQaId], references: [id])
  assignedSupervisorId String?
  assignedSupervisor   User?       @relation("SupervisorMaps", fields: [assignedSupervisorId], references: [id])
  /** Spreadsheet import fields (Sam's Club / field ops CSV) — stored, not required in UI tables */
  batch                   String?
  building                String?
  address                 String?
  mapReceived             String?
  setupStage              String?
  mapperSource            String?
  scheduleDate            String?
  mappingDate             String?
  postMappingDate         String?
  sentToStudio            String?
  receivedFromStudio      String?
  graphicsPolishAssignee  String?
  graphicsPolishStatus    String?
  polishQaAssignee        String?
  conversion              String?
  polishStage             String?
  activation              String?
  remappingDate           String?
  dashboardDate           String?
  maintDate               String?
  commentExternal         String?  @db.Text
  commentInternal         String?  @db.Text
  tasks           Task[]
  events          MapEvent[]
  phaseHistory    MapPhaseHistory[]
  attachments     MapAttachment[]
  notes           MapNote[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model MapPhaseHistory {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  phase     MapPhase
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  enteredAt DateTime @default(now())
  note      String?

  @@index([mapId, phase])
}

model MapAttachment {
  id           String   @id @default(cuid())
  mapId        String
  map          Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  data         String   @db.Text
  context      String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Task {
  id          String     @id @default(cuid())
  mapId       String
  map         Map        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  phase       MapPhase
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MapNote {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([mapId, createdAt])
}

model MapEvent {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  note      String?
  metadata  String?
  createdAt DateTime @default(now())
}

model OpsDailyReport {
  id          String   @id @default(cuid())
  reportDate  DateTime @db.Date @unique
  title       String
  summary     String   @db.Text
  payload     Json
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([reportDate(sort: Desc)])
}

model AvailabilitySubmission {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart      DateTime @db.Date
  fridayContract Boolean  @default(false)
  hagimOk        Boolean  @default(false)
  note           String?
  submittedAt    DateTime?
  days           AvailabilityDay[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model ShiftPlan {
  id          String                @id @default(cuid())
  weekStart   DateTime              @db.Date
  createdById String?
  createdBy   User?                 @relation("ShiftPlansCreated", fields: [createdById], references: [id], onDelete: SetNull)
  assignments ShiftPlanAssignment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([weekStart])
  @@index([weekStart])
}

model ShiftPlanAssignment {
  id        String    @id @default(cuid())
  planId    String
  plan      ShiftPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, dayOfWeek, userId])
  @@index([planId])
  @@index([userId])
}
model AvailabilityDay {
  id           String   @id @default(cuid())
  submissionId String
  submission   AvailabilitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  canWork      Boolean
  allDay       Boolean  @default(false)
  startMinutes Int?
  endMinutes   Int?
  /** Optional second block same day (e.g. 9–15 then 16–20) */
  startMinutes2 Int?
  endMinutes2   Int?
  note         String?

  @@unique([submissionId, dayOfWeek])
  @@index([submissionId])
}
