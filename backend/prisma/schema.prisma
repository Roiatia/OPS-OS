generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  GRAPHIC_TEAM_LEADER
  MAPPING_INSPECTOR
  GRAPHIC_QA
  OPS_ADMIN
}

enum MapPhase {
  INTAKE
  PREP
  UPLOAD_REVIEW
  FIELD
  POLISH
  QA_REVIEW
  APPROVED
  CANCELLED
}

enum MapStatus {
  ACCEPTED
  PROCESSING
  DONE
  FIX
  FIX_DONE
  APPROVED
}

enum TaskStatus {
  PENDING
  ACCEPTED
  PROCESSING
  DONE
  FIX
  FIX_DONE
}

enum WorkflowPhaseTarget {
  PRE_UPLOAD
  UPLOADED
  POLISH
  POLISHED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  avatarUrl String?
  googleId  String?    @unique
  roles     UserRole[]
  assignedMapsAsInspector Map[]  @relation("InspectorMaps")
  assignedMapsAsQa      Map[]  @relation("QaMaps")
  assignedTasks           Task[]
  createdTasks            Task[] @relation("TaskCreator")
  events                  MapEvent[]
  phaseHistory            MapPhaseHistory[]
  attachments             MapAttachment[]
  notes                   MapNote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model UserRole {
  id     String   @id @default(cuid())
  userId String
  role   RoleName
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Map {
  id              String           @id @default(cuid())
  mapNumber       String           @unique
  jiraTicketId    String?
  client          String
  area            String?
  description     String?
  dueDate         DateTime?
  phase           MapPhase         @default(INTAKE)
  status          MapStatus?
  inspectorAssignAccepted Boolean @default(false)
  qaAssignAccepted        Boolean @default(false)
  releasedToPipeline      Boolean @default(false)
  workflowPhaseTarget     WorkflowPhaseTarget @default(PRE_UPLOAD)
  uploadApproved  Boolean          @default(false)
  assignedInspectorId String?
  assignedInspector   User?        @relation("InspectorMaps", fields: [assignedInspectorId], references: [id])
  assignedQaId        String?
  assignedQa          User?        @relation("QaMaps", fields: [assignedQaId], references: [id])
  /** Spreadsheet import fields (Sam's Club / field ops CSV) — stored, not required in UI tables */
  batch                   String?
  building                String?
  address                 String?
  mapReceived             String?
  setupStage              String?
  mapperSource            String?
  mapperName              String?
  scheduleDate            String?
  mappingDate             String?
  postMappingDate         String?
  sentToStudio            String?
  receivedFromStudio      String?
  graphicsPolishAssignee  String?
  graphicsPolishStatus    String?
  polishQaAssignee        String?
  conversion              String?
  polishStage             String?
  activation              String?
  remappingDate           String?
  dashboardDate           String?
  maintDate               String?
  commentExternal         String?  @db.Text
  commentInternal         String?  @db.Text
  tasks           Task[]
  events          MapEvent[]
  phaseHistory    MapPhaseHistory[]
  attachments     MapAttachment[]
  notes           MapNote[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([phase])
  @@index([assignedInspectorId])
  @@index([assignedQaId])
  @@index([updatedAt])
  @@index([releasedToPipeline])
}

model MapPhaseHistory {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  phase     MapPhase
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  enteredAt DateTime @default(now())
  note      String?

  @@index([mapId, phase])
}

model MapAttachment {
  id           String   @id @default(cuid())
  mapId        String
  map          Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  data         String   @db.Text
  context      String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([mapId])
}

model Task {
  id          String     @id @default(cuid())
  mapId       String
  map         Map        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  phase       MapPhase
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([mapId])
}

model MapNote {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([mapId, createdAt])
}

model MapEvent {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  note      String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([mapId])
}
