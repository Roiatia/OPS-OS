generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  GRAPHIC_TEAM_LEADER
  MAPPING_INSPECTOR
  GRAPHIC_QA
  SUPERVISOR
  SUPERVISOR_SHIFT_LEADER
  OPS_ADMIN
  OPS_MANAGER_2
}

enum MapPhase {
  INTAKE
  PREP
  UPLOAD_REVIEW
  FIELD
  POLISH
  QA_REVIEW
  APPROVED
  CANCELLED
}

enum InspectorStatus {
  ACCEPTED
  PROCESSING
  DONE
}

enum SupervisorStatus {
  ACCEPTED
  PROCESSING
  DONE
}

enum FieldWorkStatus {
  UNCOMPLETED
  COMPLETED
  CANCELLED
}

enum QaStatus {
  FIX
  FIX_DONE
  APPROVED
}

enum TaskStatus {
  PENDING
  ACCEPTED
  PROCESSING
  DONE
  FIX
  FIX_DONE
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  avatarUrl String?
  googleId  String?    @unique
  shiftStartedAt DateTime?
  roles     UserRole[]
  assignedMapsAsInspector Map[]  @relation("InspectorMaps")
  assignedMapsAsQa      Map[]  @relation("QaMaps")
  assignedMapsAsSupervisor Map[] @relation("SupervisorMaps")
  assignedTasks           Task[]
  createdTasks            Task[] @relation("TaskCreator")
  events                  MapEvent[]
  phaseHistory            MapPhaseHistory[]
  attachments             MapAttachment[]
  notes                   MapNote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model UserRole {
  id     String   @id @default(cuid())
  userId String
  role   RoleName
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Map {
  id              String           @id @default(cuid())
  mapNumber       String           @unique
  jiraTicketId    String?
  client          String
  area            String?
  description     String?
  dueDate         DateTime?
  fieldDate       DateTime?
  loomDone        Boolean          @default(false)
  positioning     Boolean          @default(false)
  mapperName      String?
  opsManagerComment String?
  fieldWorkStatus FieldWorkStatus  @default(UNCOMPLETED)
  fieldProgressPercent Int          @default(0)
  onHubStatusBoard  Boolean          @default(false)
  phase           MapPhase         @default(INTAKE)
  inspectorStatus InspectorStatus?
  supervisorStatus SupervisorStatus?
  qaStatus        QaStatus?
  uploadApproved  Boolean          @default(false)
  uploadCompletedAt DateTime?
  releasedToGraphics Boolean       @default(false)
  assignedInspectorId String?
  assignedInspector   User?        @relation("InspectorMaps", fields: [assignedInspectorId], references: [id])
  assignedQaId        String?
  assignedQa          User?        @relation("QaMaps", fields: [assignedQaId], references: [id])
  assignedSupervisorId String?
  assignedSupervisor   User?       @relation("SupervisorMaps", fields: [assignedSupervisorId], references: [id])
  tasks           Task[]
  events          MapEvent[]
  phaseHistory    MapPhaseHistory[]
  attachments     MapAttachment[]
  notes           MapNote[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model MapPhaseHistory {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  phase     MapPhase
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  enteredAt DateTime @default(now())
  note      String?

  @@index([mapId, phase])
}

model MapAttachment {
  id           String   @id @default(cuid())
  mapId        String
  map          Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  data         String   @db.Text
  context      String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Task {
  id          String     @id @default(cuid())
  mapId       String
  map         Map        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  phase       MapPhase
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MapNote {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([mapId, createdAt])
}

model MapEvent {
  id        String   @id @default(cuid())
  mapId     String
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  note      String?
  metadata  String?
  createdAt DateTime @default(now())
}

model OpsDailyReport {
  id          String   @id @default(cuid())
  reportDate  DateTime @db.Date @unique
  title       String
  summary     String   @db.Text
  payload     Json
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([reportDate(sort: Desc)])
}
