# Supabase (PostgreSQL) — Session pooler URI from dashboard + sslmode
# Project Settings → Database → Connection string → Session pooler (port 5432)
# Append ?sslmode=require to both URLs.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# Local Docker fallback (when Supabase is paused or unreachable):
#   npm run db:local:setup
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ops_os?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ops_os?schema=public"

# REQUIRED in production: set to a strong random value. The server refuses to
# start when NODE_ENV=production and JWT_SECRET is missing/empty. Outside
# production an insecure dev fallback is used (with a warning).
JWT_SECRET="change-me-in-production"
GOOGLE_CLIENT_ID=""
PORT=3001

# development | production. Controls fail-fast checks and demo/dev fallbacks.
NODE_ENV=development

# Demo login. Only works outside production — forced off when NODE_ENV=production.
DEMO_MODE=false

# Comma-separated list of allowed CORS origins (production frontends).
# Localhost dev origins (5173/5174) are always allowed automatically.
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"

# Comma-separated allow-list of email domains permitted to self-register via
# Google sign-in. Leave empty/unset to allow all domains (dev default).
# ALLOWED_EMAIL_DOMAINS="oriient.me,ops-demo.local"

# Spreadsheet sync (optional — or upload CSV in OPS Maps UI)
SPREADSHEET_DEFAULT_CLIENT="Sam's Club"
# GOOGLE_SHEETS_SPREADSHEET_ID=""
# GOOGLE_SHEETS_TAB_NAME="Sheet1"
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
