{
  "name": "ops-os-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:seed-shift-plan": "tsx prisma/seed/seed-shift-plan-demo.ts",
    "db:reseed-maps": "tsx prisma/seed/reseed-demo-maps.ts",
    "db:reseed-updates": "tsx prisma/seed/reseed-demo-updates.ts",
    "db:reseed-reports": "tsx prisma/seed/seed-demo-reports.ts",
    "db:hub-demo": "node scripts/hub-demo-setup.mjs",
    "db:setup": "prisma migrate deploy && tsx prisma/seed/seed.ts",
    "db:find-pooler": "node scripts/find-pooler.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:use-local": "node scripts/switch-db.mjs local",
    "db:use-supabase": "node scripts/switch-db.mjs supabase",
    "db:local:up": "docker compose -f ../docker-compose.yml up -d postgres",
    "db:local:setup": "npm run db:local:up && node scripts/switch-db.mjs local && prisma migrate deploy && tsx prisma/seed/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "pg": "^8.22.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
